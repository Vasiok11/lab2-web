<!DOCTYPE html>
<html lang="ro" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title | default("Centrul Comercial Augustin") }}</title>
    <link rel="stylesheet" href="/assets/css/reset.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'primary': '#ffffff',
                        'secondary': '#888888',
                        'text-color': '#cccccc',
                        'bg-color': '#1a1a1a',
                        'card-bg': '#2a2a2a',
                        'accent-hover': '#aaaaaa'
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-15px)' },
                        },
                        wave: {
                            '0%, 100%': { transform: 'rotate(0deg)' },
                            '25%': { transform: 'rotate(15deg)' },
                            '75%': { transform: 'rotate(-15deg)' },
                        },
                        fadeIn: {
                            '0%': { opacity: '0', pointerEvents: 'none' },
                            '100%': { opacity: '1', pointerEvents: 'auto' },
                        }
                    },
                    animation: {
                        'float': 'float 3s ease-in-out infinite',
                        'wave': 'wave 2s ease-in-out infinite',
                        'fade-in-delay': 'fadeIn 1s ease-in-out 3s forwards, float 3s ease-in-out infinite',
                    }
                }
            }
        }
    </script>
</head>
<body class="font-sans leading-relaxed text-text-color bg-bg-color relative">
    <!-- Mascot -->
    <div class="fixed bottom-6 right-6 md:bottom-8 md:right-8 z-50 group cursor-pointer opacity-0 animate-fade-in-delay" tabindex="0">
        <div class="relative">
            <!-- Speech Bubble -->
            <div class="absolute -top-16 right-0 md:right-auto md:-left-24 bg-white text-black px-4 py-2 rounded-2xl text-sm font-bold opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus:opacity-100 shadow-lg whitespace-nowrap after:content-[''] after:absolute after:bottom-[-8px] after:right-4 after:border-t-8 after:border-t-white after:border-l-8 after:border-l-transparent after:border-r-8 after:border-r-transparent pointer-events-none">
                Salut! Cu ce te pot ajuta?
            </div>
            <!-- Mascot Image -->
            <img src="/assets/images/mascot.svg" alt="Mascot" class="w-16 h-16 md:w-32 md:h-32 drop-shadow-[0_0_15px_rgba(136,136,136,0.5)]">
        </div>
    </div>

    <header class="bg-bg-color shadow-[0_2px_5px_rgba(0,0,0,0.5)] sticky top-0 z-[100]">
        <div class="w-[90%] max-w-[1200px] mx-auto flex justify-between items-center py-4">
            <h1 class="text-xl md:text-2xl text-white font-bold uppercase tracking-[1px]">Centrul Augustin</h1>
            
            <!-- Desktop Nav -->
            <nav class="hidden md:block">
                <ul class="flex list-none">
                    <li class="ml-6"><a href="#home" class="no-underline text-text-color font-medium transition-colors duration-300 hover:text-white">Acasă</a></li>
                    <li class="ml-6"><a href="#about" class="no-underline text-text-color font-medium transition-colors duration-300 hover:text-white">Despre Noi</a></li>
                    <li class="ml-6"><a href="#shops" class="no-underline text-text-color font-medium transition-colors duration-300 hover:text-white">Magazinele Noastre</a></li>
                    <li class="ml-6"><a href="#contact" class="no-underline text-text-color font-medium transition-colors duration-300 hover:text-white">Contact</a></li>
                </ul>
            </nav>

            <!-- Mobile Menu Wrapper -->
            <div class="md:hidden group" tabindex="0">
                <!-- Mobile Menu Button -->
                <div class="text-white cursor-pointer focus:outline-none">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </div>

                <!-- Mobile Nav Menu -->
                <nav class="hidden group-focus:block group-focus-within:block bg-card-bg border-t border-solid border-[#333] absolute w-full left-0 top-full shadow-lg">
                    <ul class="flex flex-col list-none p-4 m-0">
                        <li class="py-3 border-b border-solid border-[#333]"><a href="#home" class="block no-underline text-text-color font-medium transition-colors duration-300 hover:text-white">Acasă</a></li>
                        <li class="py-3 border-b border-solid border-[#333]"><a href="#about" class="block no-underline text-text-color font-medium transition-colors duration-300 hover:text-white">Despre Noi</a></li>
                        <li class="py-3 border-b border-solid border-[#333]"><a href="#shops" class="block no-underline text-text-color font-medium transition-colors duration-300 hover:text-white">Magazinele Noastre</a></li>
                        <li class="py-3"><a href="#contact" class="block no-underline text-text-color font-medium transition-colors duration-300 hover:text-white">Contact</a></li>
                    </ul>
                </nav>
            </div>
        </div>
    </header>

    {{ content | safe }}

    <!-- Footer -->
    <footer class="bg-[#111] pt-12 md:pt-16 pb-4 text-[#888] border-t border-solid border-[#333]">
        <div class="w-[90%] max-w-[1200px] mx-auto">
            <div class="flex flex-col md:flex-row gap-10 md:gap-12 justify-between mb-12">
                <div class="w-full md:flex-[2_1_300px]">
                    <h2 class="text-white text-xl md:text-[1.5rem] mb-4 uppercase tracking-[1px]">Centrul Augustin</h2>
                    <p class="text-sm md:text-base leading-[1.6] max-w-[400px]">Centrul tău local pentru cumpărături, servicii și comunitate în inima cartierului. Tot ce ai nevoie sub același acoperiș.</p>
                </div>
                <div class="w-full md:flex-[1_1_150px]">
                    <h3 class="text-white text-lg md:text-[1.2rem] mb-4">Linkuri Rapide</h3>
                    <ul class="list-none p-0 text-sm md:text-base">
                        <li class="mb-2"><a href="#home" class="text-[#888] no-underline transition-colors duration-300 ease-in-out hover:text-white">Acasă</a></li>
                        <li class="mb-2"><a href="#about" class="text-[#888] no-underline transition-colors duration-300 ease-in-out hover:text-white">Despre Noi</a></li>
                        <li class="mb-2"><a href="#shops" class="text-[#888] no-underline transition-colors duration-300 ease-in-out hover:text-white">Magazinele Noastre</a></li>
                        <li class="mb-2"><a href="#contact" class="text-[#888] no-underline transition-colors duration-300 ease-in-out hover:text-white">Contact</a></li>
                    </ul>
                </div>
                <div class="w-full md:flex-[1_1_150px]">
                    <h3 class="text-white text-lg md:text-[1.2rem] mb-4">Urmărește-ne</h3>
                    <div class="flex flex-col gap-2 text-sm md:text-base">
                        <a href="#" class="text-[#888] no-underline transition-colors duration-300 ease-in-out hover:text-white">Facebook</a>
                        <a href="#" class="text-[#888] no-underline transition-colors duration-300 ease-in-out hover:text-white">Instagram</a>
                        <a href="#" class="text-[#888] no-underline transition-colors duration-300 ease-in-out hover:text-white">Twitter</a>
                    </div>
                </div>
            </div>
            <div class="text-center pt-8 border-t border-solid border-[#333] text-xs md:text-[0.9rem]">
                <p>&copy; 2026 Centrul Comercial Augustin. Toate drepturile rezervate.</p>
            </div>
        </div>
    </footer>
</body>
</html>